# =========================================================================
# .env.example
# نمونهٔ فایل تنظیمات محیطی — این فایل را کپی کرده و به نام «.env» ذخیره کنید.
# فایل .env هرگز نباید داخل Git یا در دسترس عمومی قرار بگیرد.
# =========================================================================

# محیط اجرا: local  یا  production
APP_ENV=local

# نمایش خطاها؛ روی هاست همیشه false باشد
APP_DEBUG=true

# آدرس پایهٔ سایت (بدون / در انتها)
# لوکال (XAMPP/Laragon): http://localhost/cafe-menu-system/public_html
# هاست:                  https://example.com
APP_URL=http://localhost/cafe-menu-system/public_html

# ---------------------- اطلاعات دیتابیس ----------------------
DB_HOST=localhost
DB_NAME=cafe_noyan
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---------------------- آپلود تصاویر ----------------------
# حداکثر حجم مجاز آپلود تصویر (بایت) — پیش‌فرض ۲ مگابایت
UPLOAD_MAX_SIZE=2097152
