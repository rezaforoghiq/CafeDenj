# =========================================================================
# .env.example
# نمونهٔ فایل تنظیمات محیطی — این فایل را کپی کرده و به نام «.env» ذخیره کنید.
# فایل .env هرگز نباید داخل Git یا در دسترس عمومی قرار بگیرد.
# =========================================================================

# محیط اجرا: local  یا  production
APP_ENV=local

# نمایش خطاها؛ روی هاست همیشه false باشد
APP_DEBUG=true

# آدرس پایهٔ سایت (بدون / در انتها)
# لوکال (XAMPP/Laragon): http://localhost/cafe-menu-system/public_html
# هاست:                  https://example.com
APP_URL=http://localhost/classes/public_html/

# ---------------------- اطلاعات دیتابیس ----------------------
DB_HOST=localhost
DB_NAME=cafe_db_1
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---------------------- OTP / SMS ----------------------
MELIPAYAMAK_USERNAME=9927779232
MELIPAYAMAK_PASSWORD=9daced57-b3b0-428e-bee2-7addef8be51b
MELIPAYAMAK_BODY_ID=515472
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
# OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_RATE_LIMIT_WINDOW_SECONDS=10
OTP_RATE_LIMIT_MAX_PER_WINDOW=5

# ---------------------- آپلود تصاویر ----------------------
# حداکثر حجم مجاز آپلود تصویر (بایت) — پیش‌فرض ۲ مگابایت
UPLOAD_MAX_SIZE=2097152
