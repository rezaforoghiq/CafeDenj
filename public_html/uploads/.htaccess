# public_html/uploads/.htaccess
# -----------------------------------------------------------------------
# جلوگیری از اجرای هر نوع اسکریپت در پوشهٔ آپلود. «Require all denied»
# مستقل از نوع هندلر PHP (mod_php، FPM یا CGI) کار می‌کند و روی همهٔ
# نسخه‌های Apache 2.4 به بالا (استاندارد امروز هاست‌های لینوکسی) پشتیبانی می‌شود.
# -----------------------------------------------------------------------

Options -Indexes

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
